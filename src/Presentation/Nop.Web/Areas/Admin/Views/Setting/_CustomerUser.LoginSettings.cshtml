@model CustomerUserSettingsModel

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="LoginSettings.DefaultLoginMethod" />
    </div>
    <div class="col-md-9">
        <nop-select asp-for="LoginSettings.DefaultLoginMethod" asp-items="Model.LoginSettings.AvailableLoginMethods" />
        <span asp-validation-for="LoginSettings.DefaultLoginMethod"></span>
    </div>
</div>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="LoginSettings.AllowUserToChangeLoginMethod" />
    </div>
    <div class="col-md-9">
        <nop-editor asp-for="LoginSettings.AllowUserToChangeLoginMethod" />
        <span asp-validation-for="LoginSettings.AllowUserToChangeLoginMethod"></span>
    </div>
</div>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="LoginSettings.RememberLastUsedMethod" />
    </div>
    <div class="col-md-9">
        <nop-editor asp-for="LoginSettings.RememberLastUsedMethod" />
        <span asp-validation-for="LoginSettings.RememberLastUsedMethod"></span>
    </div>
</div>
