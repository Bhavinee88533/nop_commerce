@removeTagHelper Nop.Web.Framework.TagHelpers.Shared.NopScriptTagHelper, Nop.Web.Framework
@removeTagHelper Nop.Web.Framework.TagHelpers.Shared.NopLinkTagHelper, Nop.Web.Framework
@{
	Layout = null;
	var customerId = (int)ViewBag.CustomerId;
	var riderName = (string)ViewBag.RiderName;
	var hubPath = (string)ViewBag.HubPath;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Rider Dashboard – @riderName</title>
	<link rel="manifest" href="/plugins/ridermanagement/manifest.json" />
	<style>
		* { box-sizing: border-box; margin: 0; padding: 0; }
		body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f6f9; color: #333; }
		header { background: #1a73e8; color: #fff; padding: 16px 24px; display: flex; align-items: center; gap: 12px; }
		header h1 { font-size: 1.2rem; }
		#status-badge { margin-left: auto; font-size: 0.8rem; padding: 4px 10px; border-radius: 12px; background: rgba(255,255,255,0.25); }
		#notification-list { max-width: 600px; margin: 24px auto; padding: 0 16px; }

		/* ── Notification card ── */
		.notif-card {
			background: #fff;
			border-left: 4px solid #1a73e8;
			border-radius: 8px;
			padding: 16px;
			margin-bottom: 12px;
			box-shadow: 0 2px 6px rgba(0,0,0,0.08);
			animation: slideIn 0.3s ease;
			transition: opacity 0.4s ease, transform 0.4s ease;
		}
		.notif-card.new   { border-left-color: #34a853; }
		.notif-card.taken { border-left-color: #fbbc04; opacity: 0.6; pointer-events: none; }
		.notif-card.fading { opacity: 0; transform: translateY(-8px); }
		.notif-card h3  { font-size: 1rem; margin-bottom: 6px; color: #1a73e8; }
		.notif-card p   { font-size: 0.875rem; color: #555; margin-bottom: 4px; }
		.notif-card time { font-size: 0.75rem; color: #999; }

		/* ── Countdown ring ── */
		.countdown-wrap {
			display: flex;
			align-items: center;
			gap: 10px;
			margin: 10px 0 6px;
		}
		.countdown-ring { position: relative; width: 44px; height: 44px; flex-shrink: 0; }
		.countdown-ring svg { transform: rotate(-90deg); }
		.countdown-ring circle.bg  { fill: none; stroke: #e8eaed; stroke-width: 4; }
		.countdown-ring circle.arc {
			fill: none;
			stroke: #34a853;
			stroke-width: 4;
			stroke-linecap: round;
			stroke-dasharray: 113; /* 2π × 18 ≈ 113 */
			stroke-dashoffset: 0;
			transition: stroke-dashoffset 1s linear, stroke 0.5s;
		}
		.countdown-ring circle.arc.warn  { stroke: #fbbc04; }
		.countdown-ring circle.arc.urgent { stroke: #ea4335; }
		.countdown-ring .num {
			position: absolute; inset: 0;
			display: flex; align-items: center; justify-content: center;
			font-size: 0.8rem; font-weight: 700; color: #333;
		}
		.countdown-label { font-size: 0.8rem; color: #777; }

		/* ── Action buttons ── */
		.action-row { display: flex; gap: 10px; margin-top: 12px; }
		.btn-accept, .btn-reject {
			flex: 1; padding: 10px 0; border: none; border-radius: 6px;
			font-size: 0.9rem; font-weight: 600; cursor: pointer;
			transition: opacity 0.2s, transform 0.1s;
		}
		.btn-accept { background: #34a853; color: #fff; }
		.btn-reject { background: #ea4335; color: #fff; }
		.btn-accept:disabled, .btn-reject:disabled { opacity: 0.5; cursor: not-allowed; }
		.btn-accept:not(:disabled):active, .btn-reject:not(:disabled):active { transform: scale(0.97); }

		/* ── Empty state ── */
		#empty-state { text-align: center; color: #888; margin-top: 60px; }
		#empty-state svg { width: 64px; height: 64px; fill: #ccc; margin-bottom: 12px; }

		/* ── Animations ── */
		@@keyframes slideIn { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
		.pulse { animation: pulse 1.5s 3; }
		@@keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(52,168,83,0.4); } 50% { box-shadow: 0 0 0 10px rgba(52,168,83,0); } }
	</style>
</head>
<body>
	<header>
		<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="white" viewBox="0 0 24 24">
			<path d="M12 2a5 5 0 1 1 0 10A5 5 0 0 1 12 2zm0 12c5.33 0 8 2.67 8 4v2H4v-2c0-1.33 2.67-4 8-4z"/>
		</svg>
		<h1>Hello, @riderName 👋</h1>
		<span id="status-badge">Connecting…</span>
	</header>

	<div id="notification-list">
		<div id="empty-state">
			<svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6V11c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
			<p>No new orders yet. You'll be notified instantly.</p>
		</div>
	</div>

	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"
			integrity="sha512-O9LMXQ5rRNFsXi1fNjLaCNX9tGDQwLkXLvkEeVLaBk4HWOR3GjGcMoRaEuIrRr3EBtqKzZ8j7b8/rLKpCUyw=="
			crossorigin="anonymous" referrerpolicy="no-referrer"></script>

	<script>
		/* ─── Configuration ─── */
		const CUSTOMER_ID       = @customerId;
		const HUB_PATH          = '@hubPath';
		const AUTO_REJECT_SECS  = 30;   // must match AutoRejectSeconds on the server
		const ACCEPT_URL        = '/RiderOrder/Accept';
		const REJECT_URL        = '/RiderOrder/Reject';

		/* ─── State ─── */
		const activeCards = new Map(); // orderId → { card, timer, remaining, intervalId }

		/* ─── Helpers ─── */
		function playBeep() {
			try {
				const ctx = new (window.AudioContext || window.webkitAudioContext)();
				const osc = ctx.createOscillator();
				const gain = ctx.createGain();
				osc.connect(gain); gain.connect(ctx.destination);
				osc.frequency.value = 880;
				gain.gain.setValueAtTime(0.4, ctx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.6);
				osc.start(); osc.stop(ctx.currentTime + 0.6);
			} catch (_) { /* audio unavailable */ }
		}

		function setEmpty(show) {
			document.getElementById('empty-state').style.display = show ? 'block' : 'none';
		}

		function removeCard(orderId, reason) {
			const entry = activeCards.get(orderId);
			if (!entry) return;
			clearInterval(entry.intervalId);
			activeCards.delete(orderId);
			const card = entry.card;
			if (reason === 'taken') card.classList.add('taken');
			card.classList.add('fading');
			setTimeout(() => {
				card.remove();
				if (activeCards.size === 0) setEmpty(true);
			}, 420);
		}

		/* ─── Countdown ring ─── */
		function startCountdown(orderId, card, seconds) {
			const arc       = card.querySelector('.arc');
			const numEl     = card.querySelector('.num');
			const CIRCUMF   = 113; // 2π × r(18)
			let remaining   = seconds;

			const intervalId = setInterval(() => {
				remaining--;
				numEl.textContent = remaining;
				arc.style.strokeDashoffset = CIRCUMF * (1 - remaining / seconds);

				if (remaining <= 10) arc.classList.add('warn');
				if (remaining <= 5)  { arc.classList.remove('warn'); arc.classList.add('urgent'); }

				if (remaining <= 0) {
					const entry = activeCards.get(orderId);
					if (entry) clearInterval(entry.intervalId);
					// Auto-reject client-side: notify server then remove card.
					postAction(REJECT_URL, orderId).catch(() => {});
					removeCard(orderId, 'expired');
				}
			}, 1000);

			const entry = activeCards.get(orderId);
			if (entry) entry.intervalId = intervalId;
		}

		/* ─── API calls ─── */
		async function postAction(url, orderId) {
			const resp = await fetch(url, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ orderId }),
				credentials: 'same-origin'
			});
			return resp.ok ? resp.json() : Promise.reject(await resp.text());
		}

		/* ─── Card factory ─── */
		function createCard(data) {
			const { orderId, orderTotal, shippingAddress, customerName, customerPhone, sentAtUtc, expiresInSeconds } = data;
			const timeoutSecs = expiresInSeconds || AUTO_REJECT_SECS;

			// Deduplicate
			if (activeCards.has(orderId)) return;

			const card = document.createElement('div');
			card.className = 'notif-card new pulse';
			card.dataset.orderId = orderId;
			card.innerHTML = `
				<h3>🛵 New Order #${orderId}</h3>
				<p>💰 <strong>${orderTotal}</strong></p>
				<p>📍 ${shippingAddress}</p>
				<p>👤 ${customerName}${customerPhone ? ` &nbsp;·&nbsp; 📞 ${customerPhone}` : ''}</p>
				<div class="countdown-wrap">
					<div class="countdown-ring">
						<svg width="44" height="44" viewBox="0 0 44 44">
							<circle class="bg"  cx="22" cy="22" r="18"/>
							<circle class="arc" cx="22" cy="22" r="18"/>
						</svg>
						<span class="num">${timeoutSecs}</span>
					</div>
					<span class="countdown-label">seconds to respond — auto-rejected after timeout</span>
				</div>
				<div class="action-row">
					<button class="btn-accept">✅ Accept</button>
					<button class="btn-reject">❌ Reject</button>
				</div>
				<time>${new Date(sentAtUtc).toLocaleTimeString()}</time>
			`;

			// Wire up buttons
			const btnAccept = card.querySelector('.btn-accept');
			const btnReject = card.querySelector('.btn-reject');

			btnAccept.addEventListener('click', async () => {
				btnAccept.disabled = btnReject.disabled = true;
				try {
					await postAction(ACCEPT_URL, orderId);
					removeCard(orderId, 'accepted');
				} catch (_) {
					// Conflict: another rider already accepted — dismiss the card.
					removeCard(orderId, 'taken');
				}
			});

			btnReject.addEventListener('click', async () => {
				btnAccept.disabled = btnReject.disabled = true;
				try { await postAction(REJECT_URL, orderId); } catch (_) {}
				removeCard(orderId, 'rejected');
			});

			// Register BEFORE starting countdown so the entry exists when the interval fires.
			activeCards.set(orderId, { card, intervalId: null });
			startCountdown(orderId, card, timeoutSecs);

			const list = document.getElementById('notification-list');
			const emptyState = document.getElementById('empty-state');
			list.insertBefore(card, emptyState);
			setEmpty(false);
		}

		/* ─── SignalR connection ─── */
		const connection = new signalR.HubConnectionBuilder()
			.withUrl(HUB_PATH)
			.withAutomaticReconnect([1000, 3000, 5000, 10000, 30000])
			.configureLogging(signalR.LogLevel.Warning)
			.build();

		connection.on('NewOrderAvailable', (data) => {
			playBeep();
			createCard(data);
		});

		connection.on('OrderNotificationExpired', ({ orderId }) => {
			// Server confirms the 30-second window has elapsed — remove the card if still visible.
			removeCard(orderId, 'expired');
		});

		connection.on('OrderAlreadyAccepted', ({ orderId }) => {
			// Another rider accepted first — dismiss this rider's card.
			removeCard(orderId, 'taken');
		});

		connection.onreconnecting(() => {
			document.getElementById('status-badge').textContent = 'Reconnecting…';
		});
		connection.onreconnected(async () => {
			document.getElementById('status-badge').textContent = '🟢 Online';
			await connection.invoke('RegisterRider', CUSTOMER_ID);
		});
		connection.onclose(() => {
			document.getElementById('status-badge').textContent = '🔴 Disconnected';
		});

		async function startConnection() {
			try {
				await connection.start();
				await connection.invoke('RegisterRider', CUSTOMER_ID);
				document.getElementById('status-badge').textContent = '🟢 Online';
			} catch (err) {
				document.getElementById('status-badge').textContent = '🔴 Connection failed';
				setTimeout(startConnection, 5000);
			}
		}

		startConnection();
	</script>

	<!-- PWA service worker registration -->
	<script>
		if ('serviceWorker' in navigator) {
			navigator.serviceWorker.register('/plugins/ridermanagement/sw.js')
				.catch(err => console.warn('SW registration failed:', err));
		}
	</script>
</body>
</html>
