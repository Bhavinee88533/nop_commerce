@{
    Layout = "";
}
<link rel="stylesheet" href="~/Plugins/ExternalAuth.Google/Content/google-auth.css" />
<div class="google-auth-block">
    <div class="buttons">
        <a asp-controller="GoogleAuthentication"
           asp-action="Login"
           asp-route-returnurl="@Context.Request.Query["ReturnUrl"]"
           class="google-sign-in-btn"
           aria-label="Sign in with Google">
            <img src="~/Plugins/ExternalAuth.Google/Content/Images/google_logo.svg"
                 alt="Google"
                 class="google-logo"
                 width="18"
                 height="18" />
            <span class="google-btn-text">Sign in with Google</span>
        </a>
    </div>
</div>
