@inherits Nop.Web.Framework.Mvc.Razor.NopRazorPage<TModel>
@inject Nop.Web.Framework.UI.INopHtmlHelper NopHtml
@model BannerListModel

@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("Widgets.BannerManagement");
    ViewBag.PageTitle = T("Plugins.Widgets.BannerManagement.Title").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.Widgets.BannerManagement.List")</h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Plugins.Widgets.BannerManagement.Create")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap">
                    <thead>
                        <tr>
                            <th>@T("Plugins.Widgets.BannerManagement.Fields.PictureId")</th>
                            <th>@T("Plugins.Widgets.BannerManagement.Fields.Title")</th>
                            <th>@T("Plugins.Widgets.BannerManagement.Fields.DisplayOrder")</th>
                            <th>@T("Plugins.Widgets.BannerManagement.Fields.IsActive")</th>
                            <th>@T("Plugins.Widgets.BannerManagement.Fields.UpdatedOnUtc")</th>
                            <th>@T("Plugins.Widgets.BannerManagement.Preview")</th>
                            <th>@T("Admin.Common.Edit")</th>
                            <th>@T("Admin.Common.Delete")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Banners.Any())
                    {
                        foreach (var banner in Model.Banners)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(banner.PreviewPictureUrl))
                                    {
                                        <img src="@banner.PreviewPictureUrl" alt="@banner.Title" style="max-height:60px;max-width:140px;" />
                                    }
                                </td>
                                <td>@banner.Title</td>
                                <td>@banner.DisplayOrder</td>
                                <td>
                                    <span class="badge @banner.StatusBadgeClass">@banner.StatusText</span>
                                </td>
                                <td>@banner.UpdatedOnUtc.ToString("u")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(banner.PreviewRedirectUrl))
                                    {
                                        <a href="@banner.PreviewRedirectUrl" target="_blank">@T("Plugins.Widgets.BannerManagement.Preview")</a>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@banner.Id" class="btn btn-default btn-sm">
                                        <i class="fas fa-pencil-alt"></i>
                                        @T("Admin.Common.Edit")
                                    </a>
                                </td>
                                <td>
                                    <form asp-action="Delete" asp-route-id="@banner.Id" method="post">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                            @T("Admin.Common.Delete")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12">@T("Plugins.Widgets.BannerManagement.NoResults")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>