@inherits Nop.Web.Framework.Mvc.Razor.NopRazorPage<TModel>
@inject Nop.Web.Framework.UI.INopHtmlHelper NopHtml
@model BannerModel

@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("Widgets.BannerManagement");
    ViewBag.PageTitle = T("Plugins.Widgets.BannerManagement.Create").Text;
}

<form asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Widgets.BannerManagement.Create")</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <a asp-action="List" class="btn btn-default">@T("Admin.Common.Cancel")</a>
        </div>
    </div>

    @await Html.PartialAsync("~/Plugins/Widgets.BannerManagement/Views/_CreateOrUpdate.cshtml", Model)
</form>