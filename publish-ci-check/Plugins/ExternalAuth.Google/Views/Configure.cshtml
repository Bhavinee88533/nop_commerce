@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="GoogleAuthentication" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">

                    <div class="form-group row">
                        <div class="col-md-12">
                            @Html.Raw(string.Format(T("Plugins.ExternalAuth.Google.Instructions").Text, webHelper.GetStoreLocation()))
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="ClientId" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ClientId" />
                            <span asp-validation-for="ClientId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="ClientSecret" />
                        </div>
                        <div class="col-md-9">
                            @* SECURITY: ClientSecret rendered as password input to prevent view-source exposure. *@
                            <input type="password" asp-for="ClientSecret" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ClientSecret"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="LoginButtonText" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="LoginButtonText" />
                            <span asp-validation-for="LoginButtonText"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="RegisterButtonText" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="RegisterButtonText" />
                            <span asp-validation-for="RegisterButtonText"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="DisplayOrder" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="DisplayOrder" />
                            <span asp-validation-for="DisplayOrder"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</form>
